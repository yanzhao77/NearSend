# Exceptions to above rules.
#
# The `*.lock` rule above is inherited from the Flutter SDK repository and would
# otherwise hide application dependency lock files. AGENTS.md §3 requires
# dependency locking and §7 requires checking the lock file before committing, so
# pubspec.lock must be tracked. When iOS CocoaPods dependencies are introduced by
# T09, ios/Podfile.lock needs the same treatment.
!pubspec.lock
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
!/dev/ci/**/Gemfile.lock

# S0 local probe outputs (reviewed historical evidence is tracked under docs/testing/)
tooling/s0/__pycache__/
tooling/s0/evidence/
tooling/s0/large-probe-*/
tooling/s0/small-probe-*/
!docs/testing/evidence/**/*.log
